NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server-only key. Never add the service-role key to a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
# Local links use the browser's current port; set this to your public site origin after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep paid registration disabled until the organizer's UPI details are ready.
NEXT_PUBLIC_MANUAL_PAYMENT_ENABLED=false
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=
NEXT_PUBLIC_UPI_QR_IMAGE=
