# VYROX Environment Configuration
# Copy this file to .env.local and populate with your Supabase credentials

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Manual UPI QR Payment Settings (India INR)
NEXT_PUBLIC_UPI_ID=vyrox.esports@okaxis
NEXT_PUBLIC_UPI_PAYEE_NAME=VYROX Esports Arena
NEXT_PUBLIC_UPI_QR_IMAGE=/images/vyrox-upi-qr.png
NEXT_PUBLIC_SUPPORT_EMAIL=support@vyroxarena.in
NEXT_PUBLIC_SUPPORT_PHONE=+919876543210
NEXT_PUBLIC_MANUAL_PAYMENT_ENABLED=true
NEXT_PUBLIC_PAID_REGISTRATION_ENABLED=true
